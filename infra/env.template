# SentinelDesk environment template. Copy to .env in the repo root and fill in the blanks:
#   cp infra/env.template .env
# Never commit .env. Hriday shares the real keys privately.

# ---- Google Gemini (embeddings + drafts) ---------------------------------
GEMINI_API_KEY=
EMBED_MODEL=gemini-embedding-2
EMBED_DIM=768
# The current Gemini Flash model id, as listed in AI Studio
GEN_MODEL=

# ---- Redis vector DB (local copy: infra/docker-compose.dev.yml) ----------
REDIS_PASSWORD=change-me-locally
REDIS_URL=redis://:change-me-locally@localhost:6379/0
REDIS_CHUNK_INDEX=idx:chunks
REDIS_CHUNK_PREFIX=chunk:
REDIS_QUEUE_PREFIX=queue:
# Set to false while running the evaluation, so it never changes the index
UPDATE_QUERIED_COUNT=true

# ---- Cloudflare R2 (raw data, splits, embeddings, models, snapshots) -----
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=sentineldesk-artifacts
ARTIFACT_VERSION=v1

# ---- Python engine --------------------------------------------------------
POLICY_PATH=engine/config/policy.yaml

# ---- Go gateway -----------------------------------------------------------
PORT=8080
ENGINE_URL=http://localhost:8000
MOCK_ENGINE=true

# ---- Optional tuning ------------------------------------------------------
LLM_TIMEOUT_S=8
GEMINI_CONCURRENCY=8
# false = skip the R2 model download at engine start (local development)
SYNC_ARTIFACTS=true
