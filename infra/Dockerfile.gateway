# Go gateway + React console in one image. Build from the repo root:
#   docker build -f infra/Dockerfile.gateway -t sentineldesk-gateway .
#
# Expects (owned by the full-stack dev):
#   backend/go.mod and backend/cmd/api/main.go   -> built with CGO_ENABLED=0
#   frontend/package.json                        -> `npm run build` writes frontend/dist
# The gateway serves the built console from WEB_DIR (set to /web below).

FROM node:22-alpine AS web
WORKDIR /frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ .
ENV VITE_USE_MOCK=false
RUN npm run build

FROM golang:1.22-alpine AS build
WORKDIR /src
COPY backend/ .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/api ./cmd/api

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/api /api
COPY --from=web /frontend/dist /web
ENV PORT=8080 WEB_DIR=/web
EXPOSE 8080
ENTRYPOINT ["/api"]
